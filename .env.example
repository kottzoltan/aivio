# Lokális fejlesztés: másold .env névre és töltsd ki, vagy állítsd be Netlify-on.

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
ELEVENLABS_API_KEY=...

# Tárolás: file (lokál / Netlify demo) | firestore | datastore
CMS_STORAGE_PROVIDER=file

# Csak firestore/datastore esetén (Netlify-on a teljes JSON egy sorban):
# GOOGLE_CLOUD_PROJECT=aivio-486419
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
