# Lokális: másold .env névre, vagy állítsd be Netlify Environment variables-ben.

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
ELEVENLABS_API_KEY=...

# Tárolás: supabase (ajánlott Netlify-ra) | file (lokál teszt) | firestore | datastore
CMS_STORAGE_PROVIDER=supabase

# Supabase — Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # titkos! csak szerveren (Netlify)
